{
  "name": "loew-runner",
  "main": "src/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dashboard",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "REQUIRE_ACCESS": "true",
    "CONTROL_WRITES": "true",
    "CONTROL_HOSTNAME": "runner.loew.fi"
  },
  "previews": {
    "vars": {
      "REQUIRE_ACCESS": "false",
      "CONTROL_WRITES": "false"
    }
  },
  "secrets": {
    "required": [
      "RUNNER_GITHUB_TOKEN"
    ]
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "loew-inspector-evidence"
    }
  ]
}
