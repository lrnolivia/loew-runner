{
  "name": "loew-runner",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A small control surface and autonomous runner for long-lived loew.fi project work.",
  "scripts": {
    "dashboard": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "tick": "node src/cli.mjs tick",
    "run": "node src/cli.mjs run",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
